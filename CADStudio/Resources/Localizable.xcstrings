    "Claude Code non è autenticato. Apri il Terminale ed esegui `claude` una volta per effettuare l’accesso.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist nicht angemeldet. Öffne das Terminal und führe einmal `claude` aus, um dich anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code is not signed in. Open Terminal and run `claude` once to sign in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code n’est pas connecté. Ouvrez le Terminal et exécutez `claude` une fois pour vous connecter."
          }
        },
