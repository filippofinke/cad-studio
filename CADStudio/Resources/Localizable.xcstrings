    "%@ non trovato": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nicht gefunden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ not found"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ introuvable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non trovato"
          }
        }
      }
    },
    "%@ non è autenticato. Apri il Terminale ed esegui `%@` per effettuare l’accesso.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht angemeldet. Öffne das Terminal und führe `%@` aus, um dich anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't signed in. Open Terminal and run `%@` to sign in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas connecté. Ouvrez le Terminal et lancez `%@` pour vous connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è autenticato. Apri il Terminale ed esegui `%@` per effettuare l’accesso."
          }
        }
      }
    },
    "%@ non è installato oppure non è stato trovato. Installalo o indica il percorso dell’eseguibile.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht installiert oder wurde nicht gefunden. Installiere es oder gib den Pfad zur ausführbaren Datei an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't installed or couldn't be found. Install it or set the path to the executable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas installé ou est introuvable. Installez-le ou indiquez le chemin de l’exécutable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è installato oppure non è stato trovato. Installalo o indica il percorso dell’eseguibile."
          }
        }
      }
    },
    "%@ scrive lo script CAD, genera il modello 3D e la tavola tecnica.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schreibt das CAD-Skript und erzeugt das 3D-Modell und die technische Zeichnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ writes the CAD script and generates the 3D model and the technical drawing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ écrit le script CAO et génère le modèle 3D et le dessin technique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ scrive lo script CAD, genera il modello 3D e la tavola tecnica."
          }
        }
      }
    },
