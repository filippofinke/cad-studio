    "Ad esempio “sonnet” oppure “opus”. Lascia vuoto per usare il modello configurato in Claude Code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel „sonnet“ oder „opus“. Leer lassen, um das in Claude Code konfigurierte Modell zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example “sonnet” or “opus”. Leave empty to use the model configured in Claude Code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple « sonnet » ou « opus ». Laissez vide pour utiliser le modèle configuré dans Claude Code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad esempio “sonnet” oppure “opus”. Lascia vuoto per usare il modello configurato in Claude Code."
          }
        }
      }
    },
