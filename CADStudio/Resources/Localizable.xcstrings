    "Codex lavora nella sua sandbox: può scrivere solo nella cartella del progetto e non usa la rete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex arbeitet in seiner Sandbox: Es darf nur im Projektordner schreiben und hat keinen Netzwerkzugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex works in its sandbox: it can only write inside the project folder and has no network access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex travaille dans son bac à sable : il ne peut écrire que dans le dossier du projet et n’accède pas au réseau."
          }
        },
