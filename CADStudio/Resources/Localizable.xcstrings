          "stringUnit": {
            "state": "translated",
            "value": "%@ ended with an error (code %d)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’est arrêté avec une erreur (code %d)."
          }
        },
